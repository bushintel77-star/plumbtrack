{
  "name": "plumbtrack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "railway": "3.10.0",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.0",
      "deepmerge-ts": ">=8.0.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4"
    }
  }
}
