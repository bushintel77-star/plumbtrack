# PostgreSQL connection string (used by Prisma in packages/database)
DATABASE_URL="postgresql://plumbtrack:plumbtrack@localhost:5432/plumbtrack"

# Fastify API
PORT=8080
HOST=0.0.0.0
# Local development marker: with NODE_ENV unset or anything other than
# development/test, the API rejects unauthenticated requests (fail closed).
NODE_ENV="development"
# Required in production. Use a randomly generated secret shared only with the
# identity/session boundary. The development fallback below must never be used
# in production.
AUTH_SECRET="replace-with-a-long-random-production-secret"
# Local demo compatibility only: allows x-organization-id without a bearer
# session (grants owner-level access to the named org). The header is rejected
# unless NODE_ENV is development/test, or this is explicitly "true". Leave
# unset or "false" everywhere that matters.
PLUMBTRACK_ALLOW_LEGACY_TENANT_HEADER=true
# Optional comma-separated browser-origin allowlist for the API (CORS).
# Unset reflects any origin, which is safe for bearer-token sessions; set it
# to lock browser callers to known deployment origins, e.g.
# CORS_ORIGINS="https://plumbtrack.up.railway.app,http://localhost:3000"
CORS_ORIGINS=""

# Slack incoming webhook URL (server-side only — never shipped to the browser).
# The notification dispatcher persists internally first, then relays here.
# Leave empty to run fully offline (in-app simulation only).
SLACK_WEBHOOK_URL=""

# Media (photo upload) signed-URL flow. Falls back to AUTH_SECRET for signing.
MEDIA_SIGNING_SECRET=""
MEDIA_UPLOAD_BASE_URL=""
MEDIA_PUBLIC_BASE_URL=""

# Web (optional override; defaults to http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
