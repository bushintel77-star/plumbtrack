# PostgreSQL connection string (used by Prisma in packages/database)
DATABASE_URL="postgresql://plumbtrack:plumbtrack@localhost:5432/plumbtrack"

# Fastify API
PORT=8080
HOST=0.0.0.0
# Per-IP request cap and sliding window (ms). Tune for production traffic.
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MS=60000
# Tight per-IP cap for the cost-incurring SMS route (POST /api/sms/eta),
# applied on top of the global limit above.
SMS_RATE_LIMIT_MAX=10
SMS_RATE_LIMIT_WINDOW_MS=60000
# Public base URL of this API deployment (no trailing slash), e.g.
# https://api-production-xxxx.up.railway.app. Media completion persists
# photo read URLs from this value; required in production — without it the
# API derives URLs from the request Host header (spoofable) and refuses to
# complete uploads instead of storing an untrusted URL.
PUBLIC_API_BASE_URL=""
# Local development marker: with NODE_ENV unset or anything other than
# development/test, the API rejects unauthenticated requests (fail closed).
NODE_ENV="development"
# Required in production. Use a randomly generated secret shared only with the
# identity/session boundary. The development fallback below must never be used
# in production.
AUTH_SECRET="replace-with-a-long-random-production-secret"
# Local demo compatibility only: allows x-organization-id without a bearer
# session (grants owner-level access to the named org). The header is rejected
# unless NODE_ENV is development/test, or this is explicitly "true". Leave
# unset or "false" everywhere that matters.
PLUMBTRACK_ALLOW_LEGACY_TENANT_HEADER=true
# Browser-origin allowlist for the API (CORS). Required in production: the
# API issues cookie sessions, so an unset allowlist would reflect arbitrary
# origins with credentials and the server refuses to boot in that state.
# e.g. CORS_ORIGINS="https://plumbtrack.up.railway.app,http://localhost:3000"
CORS_ORIGINS=""

# Slack incoming webhook URL (server-side only — never shipped to the browser).
# The notification dispatcher persists internally first, then relays here.
# Leave empty to run fully offline (in-app simulation only). Verify with
# `cd apps/api && pnpm slack:test`.
SLACK_WEBHOOK_URL=""

# Stripe Checkout payment links (test mode by default). A test-mode secret key
# creates real test sessions at no cost; leave empty to return clearly-marked
# test links so the flow works before any Stripe account exists. Stripe charges
# nothing until a client actually pays.
STRIPE_SECRET_KEY=""
PAYMENT_SUCCESS_URL="https://app.plumbtrack.example/payments/success"
PAYMENT_CANCEL_URL="https://app.plumbtrack.example/payments/cancelled"

# Twilio SMS (customer ETA notifications). Server-side only; provider-neutral
# adapter sends via the Twilio Messages REST API when these three are set.
# Leave empty to keep the ETA flow in "test" mode (returns a marked no-send).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Media (photo upload) signed-URL flow. Two modes:
#  - Railway bucket / S3-compatible (production): the .railway/railway.ts IaC
#    declares the bucket and wires MEDIA_STORAGE_* (bucket credentials)
#    automatically. Photo reads are served by the API itself via
#    GET /api/media/:assetId/file — no public bucket URL or proxy needed.
#  - HMAC gateway (dev/test): MEDIA_SIGNING_SECRET (falls back to AUTH_SECRET)
#    + MEDIA_UPLOAD_BASE_URL.
MEDIA_SIGNING_SECRET=""
MEDIA_UPLOAD_BASE_URL=""
# Railway-bucket reference variables are provided automatically by IaC; these
# are only needed when running the API outside Railway:
# MEDIA_STORAGE_ENDPOINT="https://storage.railway.app"
# MEDIA_STORAGE_BUCKET=""
# MEDIA_STORAGE_ACCESS_KEY_ID=""
# MEDIA_STORAGE_SECRET_ACCESS_KEY=""
# MEDIA_STORAGE_REGION="auto"

# Web (optional overrides; see apps/web/.env.example for the full list)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Device authentication. The API rejects the legacy org header in production,
# so field devices enroll a signed technician session via POST /api/auth/device.
# DEVICE_BOOTSTRAP_TOKEN is a per-deployment secret; the web app carries the
# same value as NEXT_PUBLIC_DEVICE_BOOTSTRAP_TOKEN (public by design — it only
# grants technician-scoped sessions, never owner/admin). DEVICE_ORG_ID pins
# enrollment to the org. In dev/test these are optional — the legacy header
# enrolls an owner session instead.
AUTH_SECRET=""
DEVICE_BOOTSTRAP_TOKEN=""
DEVICE_ORG_ID="org_caulfield_south"
NEXT_PUBLIC_DEVICE_BOOTSTRAP_TOKEN=""


# Database seed (packages/database/prisma/seed.ts) — production deployments set
# these so `pnpm db:seed` provisions the real org without code edits. Demo
# defaults apply when unset.
SEED_ORG_ID="org_caulfield_south"
SEED_ORG_NAME="Caulfield South Plumbing"
SEED_ORG_SLUG="caulfield-south-plumbing"
SEED_STANDARD_RATE=145
SEED_CALLOUT_FEE=85
# Demo jobs/quotes are seeded only when this is true (default: on for local
# dev, off in production). Re-seeding an org that already has jobs never
# injects demo fixtures, regardless of this flag.
SEED_DEMO_DATA=true

# OpenRouteService free API key (https://openrouteservice.org/dev/#/signup) — optional.
# When set in the HQ build environment, travel times upgrade from straight-line
# estimates to real road durations (one matrix call per session) and route
# polylines fetch road-following geometry through ORS directions. Without a
# key, route polylines still upgrade via the keyless OSRM demo server
# (router.project-osrm.org); travel times stay on the straight-line estimator.
# NEXT_PUBLIC_ORS_API_KEY=""
