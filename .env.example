# PostgreSQL connection string (used by Prisma in packages/database)
DATABASE_URL="postgresql://plumbtrack:plumbtrack@localhost:5432/plumbtrack"

# Fastify API
PORT=8080
HOST=0.0.0.0
# Required in production. Use a randomly generated secret shared only with the
# identity/session boundary. The development fallback below must never be used
# in production.
AUTH_SECRET="replace-with-a-long-random-production-secret"
# Local demo compatibility only: allows x-organization-id without a bearer
# session. Set to false in staging and production.
PLUMBTRACK_ALLOW_LEGACY_TENANT_HEADER=true

# Slack incoming webhook URL (server-side only — never shipped to the browser).
# The notification dispatcher persists internally first, then relays here.
# Leave empty to run fully offline (in-app simulation only).
SLACK_WEBHOOK_URL=""

# Web (optional override; defaults to http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
