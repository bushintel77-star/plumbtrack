# ── PlumbTrack web app configuration ────────────────────────────────────────
# Copy to .env.local and adjust as needed. Every variable has a
# production-safe default, so a fresh checkout runs with zero configuration.
#
# Only NEXT_PUBLIC_* values are inlined into the browser bundle. Keep
# anything secret (tokens, webhook URLs) out of these.

# Backend API base URL consumed by the sync outbox. Must be publicly
# reachable from the browser in a real deployment.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Client timeout for each API request (ms).
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# App + organisation branding (header, metadata, settings, message drawer).
NEXT_PUBLIC_APP_NAME=PlumbTrack
NEXT_PUBLIC_ORG_NAME=Caulfield South Plumbing
NEXT_PUBLIC_ORG_ID=org_caulfield_south

# Customer billing rates.
NEXT_PUBLIC_STANDARD_RATE=145
NEXT_PUBLIC_CALLOUT_FEE=85

# Pay engine: technician ordinary rate + ATO cents-per-km allowance.
NEXT_PUBLIC_STAFF_HOURLY_RATE=55
NEXT_PUBLIC_CENTS_PER_KM=88